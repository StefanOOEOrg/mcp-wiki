# Copy to ~/.config/mcp-wiki.env  (chmod 600). Used by the CLI and the ingest units.
MCP_WIKI_DIR=/srv/wiki
MCP_WIKI_DB=/srv/wiki-state/wiki.db
MCP_WIKI_LLM_BASE=http://192.168.178.87:8001/v1      # embeddings
MCP_WIKI_EMBED_MODEL=gb10-embedding
MCP_WIKI_CHAT_BASE=http://192.168.178.87:8000/v1     # chat + vision
MCP_WIKI_CHAT_MODEL=gb10-reasoning
MCP_WIKI_VISION_MODEL=gb10-reasoning
# MCP_WIKI_LLM_KEY=                                  # only if the endpoints require an API key
